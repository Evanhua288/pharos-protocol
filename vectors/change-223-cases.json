{
  "_note": "`223`（变更权与冻结期）的**反向用例**：违反者应被拒。",
  "_spec_refs": [
    "CORE-001-223",
    "CORE-001-219"
  ],
  "cases": [
    {
      "id": "冻结期内改条文",
      "kind": "edit_in_freeze",
      "desc": "对**已发布且被引用**的条，**在 60 天冻结期内直接改 `text`**",
      "expect": [
        "VIOLATION"
      ],
      "why": "223 ③：期内不得改"
    },
    {
      "id": "变更未给双哈希",
      "kind": "no_dual_hash",
      "desc": "**提交变更但未同时给出变更前后的条文哈希**",
      "expect": [
        "VIOLATION"
      ],
      "why": "223 ⑤：必须同时给双哈希"
    },
    {
      "id": "提案无实例",
      "kind": "no_instance",
      "desc": "**提案但无可复现实例**",
      "expect": [
        "REJECT"
      ],
      "why": "223 ②：无实例不进入议程"
    },
    {
      "id": "以对拍取代条款",
      "kind": "reconcile_over_clause",
      "desc": "**以“对拍一致”为由声称条款已生效**",
      "expect": [
        "VIOLATION"
      ],
      "why": "223 ⑥：不得以对拍取代条款（承 219 ③）"
    },
    {
      "id": "回溯修改已冻结包",
      "kind": "retro_edit",
      "desc": "**直接修改已冻结包内文件**",
      "expect": [
        "VIOLATION"
      ],
      "why": "223 ⑥：不得回溯"
    },
    {
      "id": "正例-新增条并标旧条已取代",
      "kind": "add_clause_ok",
      "desc": "**新增一条**，**旧条标记为已取代**且**给出双哈希**",
      "expect": [
        "OK"
      ],
      "why": "223 ④⑤：合规变更方式"
    }
  ]
}
